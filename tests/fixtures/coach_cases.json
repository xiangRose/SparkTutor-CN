        "code": "from pyspark.sql import functions as f\nfrom pyspark.sql.types import IntegerType, StringType, StructField, StructType\n\ndef transfer_sensor_aggregation(spark, readings, target_site):\n    schema = StructType([\n        StructField(\"site\", StringType(), False),\n        StructField(\"sensor_type\", StringType(), False),\n        StructField(\"reading_count\", IntegerType(), False),\n    ])\n    records = spark.createDataFrame(readings, schema)\n    totals = records.groupBy(\"site\", \"sensor_type\").agg(f.sum(\"reading_count\").alias(\"total_readings\"))\n    return totals.filter(f.col(\"site\") == \"north\").orderBy(f.desc(\"total_readings\"), f.asc(\"sensor_type\"))\n",
