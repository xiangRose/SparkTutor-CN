{
  "name": "sparktutor",
  "displayName": "SparkTutor",
  "description": "交互式 Apache Spark 4.1 学习环境，由 AI 导师辅助教学",
  "version": "0.3.0",
  "publisher": "sparktutor",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Education"
  ],
  "activationEvents": [
    "onView:sparktutorCourses",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sparktutor.run",
        "title": "SparkTutor：运行代码",
        "icon": "$(play)"
      },
      {
        "command": "sparktutor.submit",
        "title": "SparkTutor：提交代码",
        "icon": "$(check)"
      },
      {
        "command": "sparktutor.next",
        "title": "SparkTutor：下一步",
        "icon": "$(arrow-right)"
      },
      {
        "command": "sparktutor.back",
        "title": "SparkTutor：上一步",
        "icon": "$(arrow-left)"
      },
      {
        "command": "sparktutor.hint",
        "title": "SparkTutor：显示提示",
        "icon": "$(lightbulb)"
      },
      {
        "command": "sparktutor.openLesson",
        "title": "SparkTutor：打开课程"
      },
      {
        "command": "sparktutor.showSolution",
        "title": "SparkTutor：查看参考答案对比"
      },
      {
        "command": "sparktutor.changeDepth",
        "title": "SparkTutor：切换难度级别"
      },
      {
        "command": "sparktutor.resetLesson",
        "title": "SparkTutor：重置当前课程",
        "icon": "$(trash)"
      },
      {
        "command": "sparktutor.changeMode",
        "title": "SparkTutor：切换执行模式"
      },
      {
        "command": "sparktutor.checkAiConnection",
        "title": "SparkTutor：检查 AI 连接"
      }
    ],
    "keybindings": [
      {
        "command": "sparktutor.run",
        "key": "ctrl+shift+r",
        "when": "sparktutor.active"
      },
      {
        "command": "sparktutor.submit",
        "key": "ctrl+shift+s",
        "when": "sparktutor.active"
      },
      {
        "command": "sparktutor.next",
        "key": "ctrl+shift+n",
        "when": "sparktutor.active"
      },
      {
        "command": "sparktutor.back",
        "key": "ctrl+shift+b",
        "when": "sparktutor.active"
      },
      {
        "command": "sparktutor.hint",
        "key": "ctrl+shift+h",
        "when": "sparktutor.active"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sparktutor",
          "title": "SparkTutor",
          "icon": "media/sparktutor-icon.svg"
        }
      ]
    },
    "views": {
      "sparktutor": [
        {
          "id": "sparktutorCourses",
          "name": "课程"
        }
      ]
    },
    "configuration": {
      "title": "SparkTutor",
      "properties": {
        "sparktutor.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "已安装 sparktutor 的 Python 解释器路径。Windows 可使用 python 或虚拟环境中 python.exe 的完整路径。"
        },
        "sparktutor.projectPath": {
          "type": "string",
          "default": "",
          "description": "SparkTutor 项目根目录（包含 src/sparktutor/）；留空时自动查找。"
        },
        "sparktutor.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "用于 Claude 代码评审和对话的 Anthropic API 密钥；留空时读取 ANTHROPIC_API_KEY 环境变量。",
          "order": 0
        },
        "sparktutor.claudeModel": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "enum": [
            "claude-sonnet-4-6",
            "claude-haiku-4-5-20251001",
            "claude-opus-4-6"
          ],
          "description": "用于代码评审和对话的 Claude 模型。"
        },
        "sparktutor.autoCloseTabs": {
          "type": "boolean",
          "default": true,
          "description": "切换课程时自动关闭上一门课程的练习标签页。"
        },
        "sparktutor.lakehouseStackPath": {
          "type": "string",
          "default": "",
          "description": "共享湖仓环境 lakehouse-stack 的路径（如 ~/lakehouse-stack）。留空时使用课程自带的 docker-compose。"
        },
        "sparktutor.aiProvider": {
          "type": "string",
          "default": "auto",
          "enum": [
            "anthropic",
            "copilot",
            "openai-compatible",
            "auto"
          ],
          "enumDescriptions": [
            "直接使用 Anthropic API（需要 API 密钥）",
            "使用 VS Code Copilot（需要 GitHub Copilot 订阅）",
            "使用 OpenAI 兼容接口，例如 DeepSeek、智谱、通义千问、Kimi、豆包或 Ollama",
            "自动选择：Anthropic → 已配置的 OpenAI 兼容接口 → 可用的 Copilot → 仅本地检查"
          ],
          "description": "用于代码评审和导师对话的 AI 提供方。"
        },
        "sparktutor.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI 兼容接口的基础地址，例如 DeepSeek：https://api.deepseek.com/v1；本地 Ollama：http://localhost:11434/v1。",
          "order": 1
        },
        "sparktutor.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI 兼容接口的 API 密钥；留空时读取 SPARKTUTOR_OPENAI_API_KEY 或 OPENAI_API_KEY 环境变量。",
          "order": 2
        },
        "sparktutor.openaiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI 兼容接口的模型名称，例如 deepseek-chat、qwen-plus，或本地 Ollama 模型名；须与提供方支持的模型一致。",
          "order": 3
        },
        "sparktutor.openaiExtraHeaders": {
          "type": "object",
          "default": {},
          "description": "发送到 OpenAI 兼容接口的额外 HTTP 请求头（JSON 对象），例如 x-api-key 或自定义 Authorization；同名请求头会覆盖默认值。",
          "order": 4
        },
        "sparktutor.copilotModel": {
          "type": "string",
          "default": "",
          "description": "首选 GitHub Copilot 模型 ID 或系列名称；留空时自动选择可用模型。",
          "order": 5
        },
        "sparktutor.executionMode": {
          "type": "string",
          "default": "local",
          "enum": [
            "local",
            "lakehouse",
            "databricks",
            "auto"
          ],
          "enumDescriptions": [
            "本地运行 Spark（需要 PySpark 和 Java 17+，无需 Docker）",
            "通过 lakehouse-stack 的 Docker 容器运行",
            "通过 Spark Connect 连接 Databricks 集群",
            "自动检测：优先已运行的湖仓容器，否则使用本地 Spark；均不可用时仅检查语法"
          ],
          "description": "Spark 代码的执行方式。缺少 Spark 时只能检查语法，综合练习无法通过真实测试。"
        },
        "sparktutor.databricksHost": {
          "type": "string",
          "default": "",
          "description": "Databricks 工作区主机名，例如 adb-1234567890.12.azuredatabricks.net。"
        },
        "sparktutor.databricksToken": {
          "type": "string",
          "default": "",
          "description": "Databricks 个人访问令牌。"
        },
        "sparktutor.databricksClusterId": {
          "type": "string",
          "default": "",
          "description": "要连接的 Databricks 集群 ID。"
        },
        "sparktutor.databricksProfile": {
          "type": "string",
          "default": "",
          "description": "~/.databrickscfg 中的配置名称，可替代主机、令牌和集群配置。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "package": "npm run build && vsce package --no-dependencies",
    "test": "node --test tests/*.test.cjs"
  },
  "overrides": {
    "cheerio": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^2.15.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "undici": "^5.28.4",
    "vsce": "^1.103.1"
  }
}
